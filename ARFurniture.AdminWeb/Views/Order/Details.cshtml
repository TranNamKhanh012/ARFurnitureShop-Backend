@model ARFurniture.AdminWeb.Models.OrderDetailViewModel
@{
    ViewData["Title"] = "Chi tiết đơn hàng #" + Model.Id;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Chi tiết đơn hàng: #@Model.Id</h2>
    <a asp-action="Index" class="btn btn-secondary"><i class="fas fa-arrow-left"></i> Quay lại</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.OrderStatus == "ReturnRequested" || Model.OrderStatus == "Returned" || Model.OrderStatus == "ReturnRejected")
{
    <div class="card border-danger mb-4 shadow-sm">
        <div class="card-header bg-danger text-white fw-bold">
            <i class="fas fa-exclamation-triangle"></i> YÊU CẦU HOÀN TRẢ HÀNG TỪ KHÁCH
        </div>
        <div class="card-body bg-light">
            <h5 class="text-danger">Lý do từ khách hàng:</h5>
            <p class="p-3 border rounded bg-white" style="font-style: italic;">"@Model.ReturnReason"</p>

            @if (Model.OrderStatus == "ReturnRequested")
            {
                <div class="d-flex gap-2 mt-3">
                    <form asp-action="ApproveReturn" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Xác nhận đồng ý nhận lại hàng và hoàn tiền? Tồn kho sẽ được tự động cộng lại.')">
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-check"></i> Chấp nhận hoàn trả
                        </button>
                    </form>

                    <form asp-action="RejectReturn" asp-route-id="@Model.Id" method="post"
                          onsubmit="return confirm('Bạn chắc chắn muốn từ chối yêu cầu này?')">
                        <button type="submit" class="btn btn-outline-danger">
                            <i class="fas fa-times"></i> Từ chối yêu cầu
                        </button>
                    </form>
                </div>
            }
            else if (Model.OrderStatus == "Returned")
            {
                <div class="badge bg-success p-2 fs-6 mt-2">
                    <i class="fas fa-undo"></i> Đã hoàn thành việc nhận lại hàng & Hoàn tiền
                </div>
            }
            else if (Model.OrderStatus == "ReturnRejected")
            {
                <div class="badge bg-secondary p-2 fs-6 mt-2">
                    <i class="fas fa-ban"></i> Yêu cầu trả hàng đã bị từ chối
                </div>
            }
        </div>
    </div>
}

<div class="row">
    <div class="col-md-4">

        <div class="card shadow-sm mb-4 border-warning">
            <div class="card-header bg-warning text-dark fw-bold">
                <i class="fas fa-edit"></i> Cập nhật trạng thái
            </div>
            <div class="card-body">
                <form asp-action="UpdateStatus" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <select name="status" class="form-select fw-bold text-primary">
                            <!if (Model.OrderStatus == "Pending") {
                            <option value="Pending" selected>Chờ xác nhận</option> } else {
                            <option value="Pending">Chờ xác nhận</option> }
                            <!if (Model.OrderStatus == "Processing") {
                            <option value="Processing" selected>Đang xử lý</option> } else {
                            <option value="Processing">Đang xử lý</option> }
                            <!if (Model.OrderStatus == "Shipping") {
                            <option value="Shipping" selected>Đang giao hàng</option> } else {
                            <option value="Shipping">Đang giao hàng</option> }
                            <!if (Model.OrderStatus == "Completed") {
                            <option value="Completed" selected>Giao hàng thành công</option> } else {
                            <option value="Completed">Giao hàng thành công</option> }
                            <!if (Model.OrderStatus == "Cancelled") {
                            <option value="Cancelled" selected>Đã hủy</option> } else {
                            <option value="Cancelled">Đã hủy</option> }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary w-100"><i class="fas fa-save"></i> Lưu trạng thái</button>
                </form>
            </div>
        </div>
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white fw-bold">
                <i class="fas fa-truck"></i> Thông tin giao hàng
            </div>
            <div class="card-body">
                <p><strong>Người nhận:</strong> @Model.ReceiverName</p>
                <p><strong>Số điện thoại:</strong> @Model.PhoneNumber</p>
                <p><strong>Địa chỉ:</strong> @Model.ShippingAddress</p>
                <hr />
                <p><strong>Ngày đặt:</strong> @Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</p>
                <p>
                    <strong>Thanh toán:</strong> @Model.PaymentMethod -
                    <span class="@(Model.PaymentStatus == "Paid" ? "text-success fw-bold" : "text-danger fw-bold")">
                        @(Model.PaymentStatus == "Paid" ? "Đã thanh toán" : "Chưa thanh toán")
                    </span>
                </p>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white fw-bold">
                <i class="fas fa-box-open"></i> Danh sách mặt hàng
            </div>
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Sản phẩm</th>
                            <th>Size</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-end pe-3">Đơn giá</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center">
                                        <img src="http://localhost:5103/images/@item.ProductImage"
                                             alt="@item.ProductName" style="width: 50px; height: 50px; object-fit: cover;" class="rounded me-3" />
                                        <span class="fw-bold">@item.ProductName</span>
                                    </div>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.SelectedSize))
                                    {
                                        <span class="badge bg-secondary">@item.SelectedSize</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">N/A</span>
                                    }
                                </td>
                                <td class="text-center">x @item.Quantity</td>
                                <td class="text-end pe-3 text-danger fw-bold">@item.UnitPrice.ToString("#,###") ₫</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="p-4 border-top bg-light">
                    <div class="row">
                        <div class="col-md-6 offset-md-6 text-end">

                            @if (!string.IsNullOrEmpty(Model.VoucherCode))
                            {
                                <p class="mb-2">
                                    <strong>Mã áp dụng:</strong>
                                    <span class="badge bg-warning text-dark fs-6 ms-1">@Model.VoucherCode</span>
                                </p>
                                <p class="mb-2 text-danger">
                                    <strong>Mức giảm:</strong> @Model.DiscountInfo
                                </p>
                            }

                            <h4 class="text-primary mt-3 mb-0 border-top pt-3">
                                <strong>Khách phải trả:</strong> @string.Format("{0:N0} VNĐ", Model.TotalAmount)
                            </h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>