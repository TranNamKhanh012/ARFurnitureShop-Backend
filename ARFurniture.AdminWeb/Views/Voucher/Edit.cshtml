@model ARFurniture.AdminWeb.Models.VoucherViewModel

@{
    ViewData["Title"] = "Chỉnh sửa Voucher";
}

<div class="container-fluid">
    <h2 class="mt-4">Cập nhật thông tin Voucher</h2>
    <ol class="breadcrumb mb-4">
        <li class="breadcrumb-item"><a asp-action="Index">Quản lý Voucher</a></li>
        <li class="breadcrumb-item active">Chỉnh sửa</li>
    </ol>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-edit me-1"></i> Form Chỉnh Sửa Mã: <strong>@Model.Code</strong>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Mã Voucher</label>
                        <input asp-for="Code" class="form-control text-uppercase" placeholder="Ví dụ: GIAM20K" required />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Loại giảm giá</label>
                        <select asp-for="DiscountType" class="form-select">
                            <option value="FixedAmount">Số tiền cố định (đ)</option>
                            <option value="Percentage">Phần trăm (%)</option>
                        </select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Giá trị giảm</label>
                        <input asp-for="DiscountValue" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Đơn tối thiểu (VNĐ)</label>
                        <input asp-for="MinOrderValue" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Giảm tối đa (Nếu chọn %)</label>
                        <input asp-for="MaxDiscountAmount" type="number" class="form-control" placeholder="Để trống nếu không giới hạn" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Ngày bắt đầu</label>
                        <input asp-for="StartDate" type="date" class="form-control"
                               value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Ngày kết thúc</label>
                        <input asp-for="EndDate" type="date" class="form-control"
                               value="@Model.EndDate.ToString("yyyy-MM-dd")" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">Mô tả chương trình</label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Mô tả ngắn gọn về điều kiện dùng mã..."></textarea>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Số lượng mã phát hành</label>
                        <input asp-for="UsageLimit" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                            <label class="form-check-label fw-bold" for="IsActive">
                                Đang hoạt động
                            </label>
                        </div>
                    </div>
                </div>

                <hr />
                <div class="d-flex justify-content-end">
                    <a asp-action="Index" class="btn btn-secondary me-2">
                        <i class="fas fa-times"></i> Hủy bỏ
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Cập nhật ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}