@model ARFurniture.AdminWeb.Models.VoucherViewModel
@{
    ViewData["Title"] = "Thêm Voucher";
}

<div class="container-fluid">
    <h2 class="mt-4">Thiết lập Voucher mới</h2>
    <div class="card shadow-sm">
        <div class="card-body">

            @Html.ValidationSummary(true, "", new { @class = "text-danger fw-bold mb-3" })

            <form asp-action="Create" method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Mã Voucher (Ví dụ: HELLO2026)</label>
                        <input asp-for="Code" class="form-control text-uppercase" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Loại giảm giá</label>
                        <select asp-for="DiscountType" class="form-select">
                            <option value="FixedAmount">Số tiền cố định (đ)</option>
                            <option value="Percentage">Phần trăm (%)</option>
                        </select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Giá trị giảm</label>
                        <input asp-for="DiscountValue" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Đơn tối thiểu (VNĐ)</label>
                        <input asp-for="MinOrderValue" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label fw-bold">Giảm tối đa (Nếu chọn %)</label>
                        <input asp-for="MaxDiscountAmount" type="number" class="form-control" placeholder="Để trống nếu không giới hạn" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Ngày bắt đầu</label>
                        <input asp-for="StartDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Ngày kết thúc</label>
                        <input asp-for="EndDate" type="date" class="form-control" required />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label class="form-label fw-bold">Mô tả chương trình</label>
                        <textarea asp-for="Description" class="form-control" rows="2" placeholder="Ví dụ: Giảm 20k cho đơn từ 100k" required></textarea>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-bold">Số lượng mã</label>
                        <input asp-for="UsageLimit" type="number" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3 d-flex align-items-end">
                        <div class="form-check mb-2">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" value="true" checked />
                            <label class="form-check-label fw-bold">Kích hoạt ngay</label>
                        </div>
                    </div>
                </div>
                <hr />
                <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Lưu Voucher</button>
                <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
            </form>
        </div>
    </div>
</div>